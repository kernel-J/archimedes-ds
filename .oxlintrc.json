{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "jest", "oxc"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "no-unused-vars": "error",
    "import/no-default-export": "error",
    "typescript/consistent-type-imports": "warn",
    "import/no-duplicates": "warn",
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "@testing-library/jest-dom"] }],
    "eqeqeq": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "sort-imports": [
      "error",
      {
        "ignoreCase": false,
        "ignoreDeclarationSort": true,
        "ignoreMemberSort": false,
        "allowSeparatedGroups": true
      }
    ],
    "sort-keys": [
      "error",
      "asc",
      {
        "allowLineSeparatedGroups": true,
        "caseSensitive": true,
        "minKeys": 3,
        "natural": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "jest.setup.ts"],
      "env": { "jest": true },
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off",
        "typescript/switch-exhaustiveness-check": "error"
      }
    },
    {
      "files": [".storybook/**", "**/*.stories.{ts,tsx}", "vite.config.ts"],
      "rules": {
        "import/no-anonymous-default-export": "off",
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "storybook-static", "coverage", "node_modules"]
}
